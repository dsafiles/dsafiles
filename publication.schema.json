{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsafiles.com/schemas/public-research-v3.json",
  "title": "DSA Files public research publication contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 3 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "input_path", "title", "description", "canonical_url", "publication_date", "source_type", "sections", "footnotes"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "input_path": { "type": "string", "pattern": "^(?:(?:events|orgs|people)/)?\\d{4}-\\d{2}-\\d{2}-[^/\\\\]+\\.md$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": "string", "minLength": 1, "maxLength": 500 },
          "canonical_url": { "type": "string", "format": "uri", "pattern": "^https://dsafiles\\.com/research/[a-z0-9]+(?:-[a-z0-9]+)*/$" },
          "publication_date": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "source_type": { "type": "string", "enum": ["dossier", "timeline", "source-register", "structured-evidence"] },
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["section_id", "heading_path", "mode", "evidence_types"],
              "properties": {
                "section_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                "heading_path": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                "mode": { "type": "string", "enum": ["content", "heading-only"] },
                "evidence_types": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "enum": ["documented-fact", "allegation", "reported-claim", "opinion", "inference", "official-attribution", "adjudicated-finding", "qualification", "dispute", "uncertainty"] }
                }
              }
            }
          },
          "footnotes": {
            "type": "object",
            "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["source_type", "representation", "primary_url"],
                  "properties": {
                    "source_type": { "$ref": "#/$defs/footnoteSourceType" },
                    "representation": { "const": "external" },
                    "primary_url": { "type": "string", "format": "uri", "pattern": "^https://" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["source_type", "representation", "citation_text"],
                  "properties": {
                    "source_type": { "$ref": "#/$defs/footnoteSourceType" },
                    "representation": { "const": "citation-only" },
                    "citation_text": { "type": "string", "minLength": 1 }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "footnoteSourceType": {
      "type": "string",
      "enum": ["primary-record", "institutional-archive", "contemporaneous-reporting", "scholarship", "retrospective-reporting", "organizational-retrospective", "commentary"]
    }
  }
}
